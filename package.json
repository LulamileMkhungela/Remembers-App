{
  "name": "remembers-app",
  "version": "1.0.0",
  "private": true,
  "description": "Your Phone Remembers \u2014 on-device semantic search over screenshots, photos, notes and saved pages",
  "type": "module",
  "scripts": {
    "prestart": "node tools/ensure-deps.mjs",
    "start": "node server/server.js",
    "verify": "node tools/verify.mjs",
    "check:ui": "node tools/check-ui.mjs",
    "test:queries": "node tools/test-queries.mjs",
    "test:ui": "node tools/ui-test.mjs",
    "samples": "python3 tools/gen-samples.py",
    "ingest": "node tools/ingest-folder.mjs"
  },
  "dependencies": {
    "onnxruntime-node": "1.14.0",
    "onnxruntime-web": "1.30.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@ryanstark24/sfgraph-models": "1.1.3",
    "@tesseract.js-data/eng": "1.0.0",
    "linkedom": "0.18.12"
